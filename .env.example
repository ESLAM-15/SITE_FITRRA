# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string (e.g. from Supabase: Project Settings > Database >
# Connection string > "URI", using the pooled "Transaction" connection on port 6543
# when deploying to a serverless host like Vercel).
DATABASE_URL=postgresql://user:password@host:5432/database

# Allowed frontend origin (used for CORS). In dev, same-origin, so this is mostly for safety.
CLIENT_ORIGIN=http://localhost:3000

# JWT secrets - MUST be changed to long random strings in production.
# Use two different secrets so a leaked customer token can never be used as an admin token.
JWT_CUSTOMER_SECRET=please_change_this_to_a_long_random_string_customer
JWT_ADMIN_SECRET=please_change_this_to_a_long_random_string_admin

# Seed admin account (created automatically on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Cookie security - set to "true" when serving over HTTPS in production
COOKIE_SECURE=false

# Google Sign-In - create an OAuth 2.0 Client ID (Web application) in the Google Cloud
# Console and add this same value to public/js/auth.js (GOOGLE_CLIENT_ID constant).
GOOGLE_CLIENT_ID=

# Supabase Storage - used to store product images and review screenshots so they
# persist correctly on Vercel (local disk storage does not survive between requests).
# Get these from Supabase dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
